# Copy to apps/api/.env. Never put database credentials in VITE_* variables.
TA_AUTH_MODE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy projects can use SUPABASE_ANON_KEY instead.
# Vercel integration names NEXT_PUBLIC_SUPABASE_URL and POSTGRES_URL also work.
# Optional CA override when the provider rotates its certificate authority:
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Supabase Connect -> Transaction pooler. Copy the complete URL; use SSL.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
# Optional owner connection used only by npm run migrate, not runtime.
# DATABASE_DIRECT_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# Defaults: four connections locally, one on Vercel. Override only if needed.
# TA_DB_POOL_MAX=4
TA_DB_CONNECT_TIMEOUT_MS=30000
# Default idle retention: 60s locally, 5s on Vercel.
# TA_DB_IDLE_TIMEOUT_MS=60000
TA_SHUFFLE_SALT=REPLACE_WITH_A_RANDOM_SECRET_BEFORE_FIRST_ASSESSMENT
TA_PREVIEW_ENABLED=true
PORT=8787
