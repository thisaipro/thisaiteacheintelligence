# Copy to apps/web/.env.local. Vite reads this file automatically.
# Leave VITE_TA_MODE=mvp for the existing browser-only demo.
VITE_TA_MODE=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy projects can use VITE_SUPABASE_ANON_KEY instead.

# Local Vite proxy only; unnecessary on Vercel (API is in the same project).
TA_API_URL=http://localhost:8787
